{
  "name": "web-performance-mcp",
  "version": "1.0.0",
  "private": true,
  "description": "Switas Web Performance MCP: Google PageSpeed Insights, Chrome UX Report and WebPageTest tools for AI-assisted web performance audits. Based on ruslanlap/pagespeed-insights-mcp.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write src/**/*.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "bin": {
    "web-performance-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "pagespeed",
    "pagespeed-insights",
    "performance",
    "web-performance",
    "core-web-vitals",
    "crux",
    "chrome-ux-report",
    "google",
    "lighthouse",
    "lighthouse-ci",
    "claude",
    "model-context-protocol",
    "seo",
    "accessibility",
    "ai-tools",
    "lcp",
    "fcp",
    "cls",
    "ttfb",
    "webpagetest",
    "wpt",
    "switas"
  ],
  "author": {
    "name": "Switas",
    "url": "https://switas.com"
  },
  "contributors": [
    {
      "name": "ruslanlap",
      "url": "https://github.com/ruslanlap"
    }
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/switaslabs/web-performance-mcp.git"
  },
  "homepage": "https://github.com/switaslabs/web-performance-mcp#readme",
  "bugs": {
    "url": "https://github.com/switaslabs/web-performance-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "p-limit": "^7.3.1",
    "p-retry": "^9.0.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.9.1",
    "nock": "^14.0.17",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "overrides": {
    "fast-copy": "^4.1.2",
    "fast-uri": "^3.1.9",
    "proxy-addr": "^2.0.8",
    "qs": "^6.17.1"
  }
}
